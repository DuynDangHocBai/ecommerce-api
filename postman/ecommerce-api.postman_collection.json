{
  "info": {
    "name": "ecommerce-api",
    "description": "Bộ request thực hành 2 - Monolithic ecommerce-api. Trước khi chấm: sửa biến username (Mục 6), pidX và pidY (lấy từ Mục 5) trong tab Variables của collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "username", "value": "sv_test01" },
    { "key": "password", "value": "Test@123456" },
    { "key": "pidX", "value": "3" },
    { "key": "pidY", "value": "4" },
    { "key": "token", "value": "" },
    { "key": "oid", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health check",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Register (Mục 6)",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"fullname\": \"Nguyen Van A\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login (Mục 6)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.token) {",
              "  pm.collectionVariables.set(\"token\", data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Order - No token, expect 401 (Mục 7a)",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"pid\": {{pidX}}, \"qty\": 2 },\n    { \"pid\": {{pidY}}, \"qty\": 5 }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "4. Order - With token, SEND ONCE (Mục 7b)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.oid) {",
              "  pm.collectionVariables.set(\"oid\", data.oid);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"pid\": {{pidX}}, \"qty\": 2 },\n    { \"pid\": {{pidY}}, \"qty\": 5 }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "5. Get order detail (Mục 7c)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{oid}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{oid}}"]
        }
      }
    },
    {
      "name": "6. Get shipments (Mục 7d)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{oid}}/shipments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{oid}}", "shipments"]
        }
      }
    }
  ]
}
